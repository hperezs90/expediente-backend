# --- Base de datos (obligatoria) ---
DATABASE_URL=postgresql://usuario:password@localhost:5432/expediente

# --- Seguridad (obligatoria en producción: usa un valor largo y aleatorio) ---
SECRET_KEY=cambia-esto

# --- Multi-empresa / subdominios ---
BASE_DOMAIN=
TENANT_POR_DEFECTO=
PLATAFORMA_TOKEN=
PLATAFORMA_ADMIN_EMAIL=
PLATAFORMA_ADMIN_PASSWORD=

# --- Identidad por defecto de la instalación (cada empresa puede definir la suya) ---
APP_NAME=Expediente
APP_TAGLINE=Ningún trámite se vence sin avisar.
APP_PRIMARY_COLOR=#2e7d4f
APP_LOGO_URL=
INACTIVIDAD_MINUTOS=5

# --- Reglas de negocio (opcional) ---
PLAZO_OBSERVACION_MESES=3
VENTANA_RENOVACION_DIAS=90
UMBRALES_VENCIMIENTO=60,30,15
UMBRALES_OBSERVACION=90,60,30,10

# --- Alertas por correo, vía Resend (opcional) ---
RESEND_API_KEY=
# Solo la dirección (alertas@tudominio.com, con el dominio verificado en Resend). El nombre mostrado es el de cada empresa.
ALERT_FROM_EMAIL=
CORREO_UNICO_ALERTAS=

# --- Almacenamiento de documentos ---
# Por defecto se guardan en disco (STORAGE_DIR). En Railway monta un Volume (ej. en /data) y usa STORAGE_DIR=/data/uploads.
STORAGE_DIR=uploads
# Opcional: si defines las 4 variables B2_*, se usa S3 / Backblaze B2 en lugar del disco.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT_URL=
